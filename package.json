{
  "name": "lexforge",
  "version": "1.0.0",
  "description": "Spec-driven pipeline with gates that agents cannot skip",
  "license": "MIT",
  "author": "shepaland",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shepaland/LexForge.git"
  },
  "homepage": "https://github.com/shepaland/LexForge#readme",
  "bugs": {
    "url": "https://github.com/shepaland/LexForge/issues"
  },
  "keywords": [
    "spec-driven",
    "openspec",
    "agent",
    "cli",
    "skills"
  ],
  "type": "module",
  "bin": {
    "lexforge": "bin/lexforge.js"
  },
  "files": [
    "dist/**/*.js",
    "bin",
    "schemas",
    "skills",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:skills": "vitest run tests/skills",
    "test:all": "npm run build && vitest run"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
